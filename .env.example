# ==============================================================================
# Google Cloud & Vertex AI Configuration
# ==============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# ==============================================================================
# Observability & Telemetry (OpenTelemetry / Cloud Trace)
# ==============================================================================
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
GENAI_TELEMETRY_PATH=completions


# ==============================================================================
# BigQuery Agent Analytics Plugin
# ==============================================================================
BQ_ANALYTICS_DATASET_ID=adk_agent_analytics
# BQ_ANALYTICS_GCS_BUCKET=your-gcs-analytics-bucket
# BQ_ANALYTICS_CONNECTION_ID=your-bigquery-connection-id

# ==============================================================================
# Session Management (Agent Platform Sessions / Vertex AI)
# ==============================================================================
USE_VERTEX_AI_SESSIONS=false
# AGENT_ENGINE_ID=projects/your-project/locations/us-central1/reasoningEngines/your-engine-id

# ==============================================================================
# FastAPI Server Configuration
# ==============================================================================
ALLOW_ORIGINS=*
# LOGS_BUCKET_NAME=your-gcs-logs-bucket

# ==============================================================================
# PII Redaction Configuration (Datos Sensibles / Cloud DLP / SDP)
# ==============================================================================
ENABLE_PII_REDACTION=true
# Modes:
# - traces_only: Model receives unredacted text; OpenTelemetry trace exports and BigQuery redact PII.
# - in_flight: ADK plugin redacts PII before calling LLM.
# - both: Redacts both LLM payload, trace exports, and BigQuery analytics.
# - disabled: No redaction.
PII_REDACTION_MODE=traces_only

# Engine:
# - hybrid: (Recommended) Uses Google Cloud DLP (SDP) with automatic fallback to local regex.
# - dlp: Exclusively Google Cloud DLP API.
# - regex: Exclusively local regex patterns.
PII_ENGINE=hybrid
DLP_LOCATION=us-central1
# DLP_DEIDENTIFY_TEMPLATE=agent-template
# DLP_INFO_TYPES=EMAIL_ADDRESS,PHONE_NUMBER,PERSON_NAME,CREDIT_CARD_NUMBER,US_SOCIAL_SECURITY_NUMBER,IP_ADDRESS

# DLP_DEIDENTIFY_TEMPLATE=projects/your-project/locations/global/deidentifyTemplates/your-template-id
# DLP_INSPECT_TEMPLATE=projects/your-project/locations/global/inspectTemplates/your-template-id
# DLP_MIN_LIKELIHOOD=LIKELY
# PII_TOKEN_FORMAT=info_type


