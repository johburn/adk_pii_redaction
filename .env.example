# ==============================================================================
# Google Cloud & Vertex AI Configuration
# ==============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# ==============================================================================
# Observability & Telemetry (OpenTelemetry / Cloud Trace)
# ==============================================================================
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
GENAI_TELEMETRY_PATH=completions

# ==============================================================================
# BigQuery Agent Analytics Plugin
# ==============================================================================
BQ_ANALYTICS_DATASET_ID=adk_agent_analytics
# BQ_ANALYTICS_GCS_BUCKET=your-gcs-analytics-bucket
# BQ_ANALYTICS_CONNECTION_ID=your-bigquery-connection-id

# ==============================================================================
# Session Management (Agent Platform Sessions / Vertex AI)
# ==============================================================================
USE_VERTEX_AI_SESSIONS=false
# AGENT_ENGINE_ID=projects/your-project/locations/us-central1/reasoningEngines/your-engine-id

# ==============================================================================
# FastAPI Server Configuration
# ==============================================================================
ALLOW_ORIGINS=*
# LOGS_BUCKET_NAME=your-gcs-logs-bucket

# ==============================================================================
# PII Redaction Configuration (Datos Sensibles)
# ==============================================================================
ENABLE_PII_REDACTION=true
# Modes:
# - traces_only: Model receives unredacted text; OpenTelemetry trace exports redact PII.
# - in_flight: ADK plugin redacts PII before calling LLM.
# - both: Redacts both LLM payload and trace exports.
# - disabled: No redaction.
PII_REDACTION_MODE=traces_only

